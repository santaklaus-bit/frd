{
  "name": "blog-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:config": "esbuild source.config.ts --bundle --format=esm --outfile=.source/source.config.mjs --platform=node --external:fumadocs-mdx/config --external:zod",
    "dev": "fumadocs-mdx && npm run build:config && next dev --turbopack",
    "build": "fumadocs-mdx && npm run build:config && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "fumadocs-mdx && npm run build:config",
    "db:setup": "npx sequelize-cli db:create || true && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all || true"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-underline": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "fumadocs-core": "^15.6.2",
    "fumadocs-mdx": "^11.6.10",
    "fumadocs-ui": "^15.6.2",
    "geist": "^1.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.11",
    "mysql2": "^3.19.0",
    "next": "^16.0.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0",
    "sequelize": "^6.37.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "sequelize-cli": "^6.6.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}