{
  "name": "blog-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:config": "esbuild source.config.ts --bundle --format=esm --outfile=.source/source.config.mjs --platform=node --external:fumadocs-mdx/config --external:zod",
    "dev": "fumadocs-mdx && npm run build:config && next dev --turbopack",
    "build": "fumadocs-mdx && npm run build:config && next build && npm run db:init:all",
    "start": "npm run db:init:all && next start",
    "lint": "next lint",
    "postinstall": "fumadocs-mdx && npm run build:config",
    "db:setup": "npx sequelize-cli db:create || true && npx sequelize-cli db:migrate && node scripts/sync-schema.js && npx sequelize-cli db:seed:all || true",
    "db:init:testimonials": "node scripts/create-testimonials-table.js || true",
    "db:init:all": "npm run db:setup && npm run db:init:testimonials"
  },
  "dependencies": {
    "@editorjs/checklist": "^1.6.0",
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/embed": "^2.8.0",
    "@editorjs/header": "^2.8.8",
    "@editorjs/image": "^2.10.3",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/link": "^2.6.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/paragraph": "^2.11.7",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.5",
    "@editorjs/warning": "^1.4.1",
    "@google-analytics/data": "^5.2.1",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-underline": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "editorjs-html": "^4.0.5",
    "framer-motion": "^12.34.0",
    "fumadocs-core": "^15.6.2",
    "fumadocs-mdx": "^11.6.10",
    "fumadocs-ui": "^15.6.2",
    "geist": "^1.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.11",
    "mysql2": "^3.19.0",
    "next": "^16.0.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.7",
    "recharts": "^3.7.0",
    "sequelize": "^6.37.8",
    "sonner": "^2.0.7",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "sequelize-cli": "^6.6.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vite": "^5.4.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "protobufjs",
      "sharp",
      "sqlite3",
      "unrs-resolver"
    ]
  }
}
