# Node 22.13+ ; Node 24 LTS recommended
NEXT_PUBLIC_SITE_URL=https://opuscrp.com

# Keep this folder across deployments. Contains the database and uploaded files.
OPUS_DATA_DIR=./var/opus

# Exact public origin, without a trailing slash. Leave unset for local development.
# OPUS_APP_ORIGIN=https://opuscrp.com

# Create the first administrator interactively with npm run admin:create.
# No default account or password is provided.
