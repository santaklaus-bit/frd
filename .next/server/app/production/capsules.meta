{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/production/layout,_N_T_/production/capsules/layout,_N_T_/production/capsules/page,_N_T_/production/capsules"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/production/capsules/__PAGE__",
    "/production/capsules",
    "/production",
    "/_index",
    "/_head"
  ]
}