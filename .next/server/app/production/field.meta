{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/production/layout,_N_T_/production/field/layout,_N_T_/production/field/page,_N_T_/production/field"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/production/field/__PAGE__",
    "/production/field",
    "/production",
    "/_index",
    "/_head"
  ]
}